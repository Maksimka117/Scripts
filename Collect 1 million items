local function getSellPoints()
    local sell = WS:FindFirstChild("SellBlockFolder") and WS.SellBlockFolder:FindFirstChild("SellBlock")
    if not sell then return {} end
    local cf, sz = sell.CFrame, sell.Size
    local offX, offZ = sz.X * 0.5 * 0.65, sz.Z * 0.5 * 0.65
    return { 
        cf * CFrame.new(offX, 0, offZ), cf * CFrame.new(-offX, 0, offZ), 
        cf * CFrame.new(offX, 0, -offZ), cf * CFrame.new(-offX, 0, -offZ) 
    }
end

local function farmStep()
    local LocalItems = WS:FindFirstChild("LocalItems")
    if not LocalItems then return end
    local pts = getSellPoints()
    if #pts == 0 then return end
    local sellPos = pts[1].Position
    
    for i, part in ipairs(LocalItems:GetChildren()) do
        if part:IsA("BasePart") or part:IsA("Model") then
            local partPos = part:IsA("Model") and part:GetPivot().Position or part.Position
            if (partPos - sellPos).Magnitude > 15 then
                local target = pts[((i - 1) % #pts) + 1]
                pcall(function() 
                    if part:IsA("Model") then part:PivotTo(target) else part.CFrame = target end 
                end)
            end
        end
    end
end

local function setFarm(on)
    STATE.farm = on
    if STATE.farmThr then pcall(task.cancel, STATE.farmThr); STATE.farmThr = nil end
    if on then
        STATE.farmThr = task.spawn(function()
            while STATE.running and STATE.farm do
                farmStep()
                task.wait(0.1) 
            end
        end)
    end
end

