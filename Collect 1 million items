local function isGemUpgrade(u)
    return u.id:find("Upgrade", 1, true) ~= nil or u.id:find("Gem", 1, true) ~= nil or u.id:find("Chance", 1, true) ~= nil
end

local function setAutoUpgradeMode(on, gemMode)
    local stateKey = gemMode and "autoUpgrGem" or "autoUpgrCash"
    local threadKey = gemMode and "upgrGemThr" or "upgrCashThr"
    STATE[stateKey] = on
    if STATE[threadKey] then pcall(task.cancel, STATE[threadKey]); STATE[threadKey] = nil end
    if on then
        STATE[threadKey] = task.spawn(function()
            while STATE.running and STATE[stateKey] do
                if not (not gemMode and STATE.rebirthReady) then
                    for _, u in ipairs(UPGRADE_LIST) do
                        if not STATE.running or not STATE[stateKey] then break end
                        if isGemUpgrade(u) == gemMode and SELECTED_UPGRADES[u.id] then
                            pcall(function() if BuyUpgrade then BuyUpgrade:FireServer(u.id, not gemMode) end end)
                            task.wait(0.15)
                        end
                    end
                else
                    task.wait(0.5)
                end
                task.wait(1.5)
            end
        end)
    end
end

local function setAutoUpgradeCash(on) setAutoUpgradeMode(on, false) end
local function setAutoUpgradeGem(on) setAutoUpgradeMode(on, true) end

local function setAutoPotion(on)
    STATE.autoPotion = on
    if STATE.potionThr then pcall(task.cancel, STATE.potionThr); STATE.potionThr = nil end
    if on then STATE.potionThr = task.spawn(function() while STATE.running and STATE.autoPotion do for _, p in ipairs(POTIONS) do pcall(function() UsePotion:InvokeServer(p, "All") end); task.wait(0.2) end; task.wait(5) end end) end
end

local function setAutoRebirth(on)
    STATE.autoRebirth = on
    if STATE.rebConn then STATE.rebConn:Disconnect(); STATE.rebConn = nil end
    if on then
        local lastRebirth = RebirthVal.Value
        STATE.rebConn = Run.Heartbeat:Connect(function()
            if not STATE.running or not STATE.autoRebirth then return end
            if RebirthVal.Value > lastRebirth then lastRebirth = RebirthVal.Value; STATE.rebirthReady = false end
            if not STATE.rebirthReady and RebirthVal.Value < MAX_REBIRTH then
                local price = RebirthPricing and RebirthPricing.Prices and RebirthPricing.Prices[RebirthVal.Value + 1]
                if not price or CashVal.Value >= price then
                    STATE.rebirthReady = true
                    task.spawn(function()
                        pcall(function() BuyRebirth:FireServer("9FC6DA16-7C68-4868-96CB-43423A4DE6B4", RebirthVal.Value, PrestigeVal.Value, true) end)
                        task.wait(1.5)
                        STATE.rebirthReady = false
                    end)
                end
            end
        end)
    else STATE.rebirthReady = false end
end

local function setAutoPrestige(on)
    STATE.autoPrestige = on
    if STATE.presThr then pcall(task.cancel, STATE.presThr); STATE.presThr = nil end
    if on then
        STATE.presThr = task.spawn(function()
            while STATE.running and STATE.autoPrestige do
                if RebirthVal.Value >= MAX_REBIRTH then
                    pcall(function() BuyPrestige:FireServer("05858762-10B4-440C-AE05-D24BBB4E47B5", PrestigeVal.Value, RebirthVal.Value, false) end)
                    task.wait(1)
                    pcall(function() BuyPrestige:FireServer("05858762-10B4-440C-AE05-D24BBB4E47B5", PrestigeVal.Value, PrestigeVal.Value, false) end)
                    task.wait(3)
                else task.wait(2) end
            end
        end)
    end
end

-- AUTO ABILITY (Умная)
local function setAutoAbility(on)
    STATE.autoAbility = on
    if STATE.abilityThr then pcall(task.cancel, STATE.abilityThr); STATE.abilityThr = nil end
    
    if on then
        STATE.abilityThr = task.spawn(function()
            while STATE.running and STATE.autoAbility do
                local currentAbility = "Refiller"
                local PlayerGui = LP:FindFirstChild("PlayerGui")
                
                if PlayerGui then
                    local abilityText = PlayerGui.Main.CenterBar.CenterFrame.MainFrame.AbilityBtn:FindFirstChild("AbilityText")
                    if abilityText and abilityText:IsA("TextLabel") and abilityText.Text ~= "" then
                        currentAbility = string.gsub(abilityText.Text, "[%[%]]", "")
                    end
                end

                pcall(function()
                    VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.E, false, game)
                    task.wait(0.05)
                    VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.E, false, game)
                end)

                local cd = ABILITY_COOLDOWNS[currentAbility] or 5
                if LP:GetAttribute("OwnsGamepass_FasterAbilityCooldowns") then
                    cd = cd * 0.85
                end
                task.wait(cd + 1)
            end
        end)
    end
end

-- AUTO BUY AURA & TRAIL
local AuraShop = require(RS.Others:WaitForChild("AuraShop"))
local TrailShop = require(RS.Others:WaitForChild("TrailShop"))
local GemVal = LP.HiddenStats:WaitForChild("Gem")
local AuraOwned = LP.HiddenStats:WaitForChild("AuraOwned")
local TrailOwned = LP.HiddenStats:WaitForChild("TrailOwned")

local function autoBuyAuras()
    if not BuyAuraRemote or not AuraOwned then return end
    for auraName, auraData in pairs(AuraShop.Auras) do
        if auraData.Price and auraData.PreviousAura then
            if AuraOwned:FindFirstChild(auraData.PreviousAura) and not AuraOwned:FindFirstChild(auraName) and GemVal.Value >= auraData.Price then
                pcall(function() BuyAuraRemote:FireServer(auraName) end)
                task.wait(1)
                return
            end
        end
    end
end

local function autoBuyTrails()
    if not BuyTrailRemote or not TrailOwned then return end
    for trailName, trailData in pairs(TrailShop.Trails) do
        if trailData.Price and trailData.PreviousTrail then
            if TrailOwned:FindFirstChild(trailData.PreviousTrail) and not TrailOwned:FindFirstChild(trailName) and GemVal.Value >= trailData.Price then
                pcall(function() BuyTrailRemote:FireServer(trailName) end)
                task.wait(1)
                return
            end
        end
    end
end

local function setAutoBuyAura(on)
    STATE.autoBuyAura = on
    if STATE.auraThr then pcall(task.cancel, STATE.auraThr); STATE.auraThr = nil end
    if on then STATE.auraThr = task.spawn(function() while STATE.running and STATE.autoBuyAura do autoBuyAuras(); task.wait(2) end end) end
end

local function setAutoBuyTrail(on)
    STATE.autoBuyTrail = on
