local dragging, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true; dragStart = input.Position; startPos = main.Position
    end
end)
UIS.InputChanged:Connect(function(input)
    if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)
UIS.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragging = false
    end
end)

local dragO, startO, posO
openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
        dragO = true; startO = input.Position; posO = openBtn.Position
    end
end)
openBtn.InputChanged:Connect(function(input)
    if dragO and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
        local d = input.Position - startO
        openBtn.Position = UDim2.new(posO.X.Scale, posO.X.Offset + d.X, posO.Y.Scale, posO.Y.Offset + d.Y)
    end
end)
openBtn.InputEnded:Connect(function(input)
    if dragO and (input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch) then
        dragO = false
        local dx = math.abs(openBtn.Position.X.Offset - posO.X.Offset)
        local dy = math.abs(openBtn.Position.Y.Offset - posO.Y.Offset)
        if dx < 5 and dy < 5 then expand() end
    end
end)

