            Position = on and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
            BackgroundColor3 = on and Color3.new(1, 1, 1) or C.dim,
        }):Play()
        if callCallback and onToggle then onToggle(on) end
    end
    sw.MouseButton1Click:Connect(function()
        if STATE.running then set(not state, true) end
    end)
    return {Set = function(on) set(on, true) end, Get = function() return state end}
end

