local function makeUpgradeDropdown(parent, titleText, gemMode)
    local wrapper = Instance.new("Frame")
    wrapper.LayoutOrder = #parent:GetChildren() + 1
    wrapper.Size = UDim2.new(1, -3, 0, 0)
    wrapper.AutomaticSize = Enum.AutomaticSize.Y
    wrapper.BackgroundTransparency = 1
    wrapper.Parent = parent

    local wrapperLayout = Instance.new("UIListLayout")
    wrapperLayout.Padding = UDim.new(0, 5)
    wrapperLayout.SortOrder = Enum.SortOrder.LayoutOrder
    wrapperLayout.Parent = wrapper

    local head = Instance.new("TextButton")
    head.LayoutOrder = 1
    head.Size = UDim2.new(1, 0, 0, 36)
    head.BackgroundColor3 = C.elem
    head.Text = titleText .. "  [+]"
    head.TextColor3 = C.text
    head.TextSize = 12
    head.Font = Enum.Font.GothamBold
    head.AutoButtonColor = false
    head.BorderSizePixel = 0
    head.Parent = wrapper
    Instance.new("UICorner", head).CornerRadius = UDim.new(0, 8)
    local hs = Instance.new("UIStroke"); hs.Color = C.stroke; hs.Thickness = 1; hs.Parent = head

    local body = Instance.new("Frame")
    body.LayoutOrder = 2
    body.Size = UDim2.new(1, 0, 0, 0)
    body.AutomaticSize = Enum.AutomaticSize.Y
    body.BackgroundColor3 = C.panel
    body.BorderSizePixel = 0
    body.Visible = false
    body.Parent = wrapper
    Instance.new("UICorner", body).CornerRadius = UDim.new(0, 8)
    local bs = Instance.new("UIStroke"); bs.Color = C.stroke; bs.Thickness = 1; bs.Parent = body
    local bp = Instance.new("UIPadding")
    bp.PaddingTop = UDim.new(0, 7); bp.PaddingBottom = UDim.new(0, 7)
    bp.PaddingLeft = UDim.new(0, 7); bp.PaddingRight = UDim.new(0, 7)
    bp.Parent = body
    local bodyLayout = Instance.new("UIListLayout")
    bodyLayout.Padding = UDim.new(0, 4)
    bodyLayout.SortOrder = Enum.SortOrder.LayoutOrder
    bodyLayout.Parent = body

    local open = false
    head.MouseButton1Click:Connect(function()
        open = not open
        body.Visible = open
        head.Text = titleText .. (open and "  [−]" or "  [+]")
        head.BackgroundColor3 = open and C.accent2 or C.elem
    end)

    local actions = Instance.new("Frame")
    actions.LayoutOrder = 1
    actions.Size = UDim2.new(1, 0, 0, 28)
    actions.BackgroundTransparency = 1
    actions.Parent = body
    local function smallButton(text, xScale, widthScale, callback)
        local b = Instance.new("TextButton")
        b.Size = UDim2.new(widthScale, -3, 1, 0)
        b.Position = UDim2.new(xScale, 0, 0, 0)
        b.BackgroundColor3 = C.elem
        b.Text = text
        b.TextColor3 = C.text
        b.TextSize = 10
        b.Font = Enum.Font.GothamBold
        b.BorderSizePixel = 0
        b.AutoButtonColor = false
        b.Parent = actions
        Instance.new("UICorner", b).CornerRadius = UDim.new(0, 6)
        b.MouseButton1Click:Connect(callback)
        return b
    end

    local rowControls = {}
    local function setVisibleClass(value)
        for _, u in ipairs(UPGRADE_LIST) do
            if isGemUpgrade(u) == gemMode then
                SELECTED_UPGRADES[u.id] = value
                local row = rowControls[u.id]
                if row then
                    row.Text = (value and "✓   " or "□   ") .. u.name
                    row.BackgroundColor3 = value and C.accent2 or C.elem
                end
            end
        end
    end
    smallButton("SELECT ALL", 0, 0.5, function() setVisibleClass(true) end)
    smallButton("DESELECT ALL", 0.5, 0.5, function() setVisibleClass(false) end)

    local itemOrder = 1
    for _, upgrade in ipairs(UPGRADE_LIST) do
        local u = upgrade
        if isGemUpgrade(u) == gemMode then
            local row = Instance.new("TextButton")
            row.LayoutOrder = itemOrder + 1
            itemOrder += 1
            row.Size = UDim2.new(1, 0, 0, 30)
            row.BackgroundColor3 = SELECTED_UPGRADES[u.id] and C.accent2 or C.elem
            row.Text = (SELECTED_UPGRADES[u.id] and "✓   " or "□   ") .. u.name
            row.TextColor3 = C.text
            row.TextSize = 11
            row.Font = Enum.Font.Gotham
            row.TextXAlignment = Enum.TextXAlignment.Left
            row.BorderSizePixel = 0
            row.AutoButtonColor = false
            row.Parent = body
            Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)
            rowControls[u.id] = row
            row.MouseButton1Click:Connect(function()
                SELECTED_UPGRADES[u.id] = not SELECTED_UPGRADES[u.id]
                local selected = SELECTED_UPGRADES[u.id]
                row.Text = (selected and "✓   " or "□   ") .. u.name
                row.BackgroundColor3 = selected and C.accent2 or C.elem
            end)
        end
    end
    return wrapper
end

