local CONFIG_FILE = "ItemFarmer_Config.json"
local GUI_Toggles = {
    Farm = farmSwitch, AutoIndex = indexSwitch, AutoPotion = potionSwitch,
    AutoRebirth = rebirthSwitch, AutoPrestige = prestigeSwitch,
    AutoUpgradeCash = cashUpgradeSwitch, AutoUpgradeGem = gemUpgradeSwitch,
    AutoAura = auraSwitch, AutoTrail = trailSwitch, AutoAbility = abilitySwitch,
}

task.spawn(function()
    local lastSavedJSON = ""
    while STATE.running do
        task.wait(3)
        local data = { Toggles = {}, Upgrades = SELECTED_UPGRADES }
        for name, switchObj in pairs(GUI_Toggles) do data.Toggles[name] = switchObj.Get() end
        
        local json = HttpService:JSONEncode(data)
        if json ~= lastSavedJSON then
            lastSavedJSON = json
            if writefile then pcall(function() writefile(CONFIG_FILE, json) end) end
        end
    end
end)

local function loadConfig()
    if not readfile or not isfile or not isfile(CONFIG_FILE) then return end
    local success, content = pcall(readfile, CONFIG_FILE)
    if not success or not content then return end
    local success2, data = pcall(function() return HttpService:JSONDecode(content) end)
    if not success2 or type(data) ~= "table" then return end
    
    print("[Item Farmer] Загружаем сохраненный конфиг...")
    if data.Toggles then
        for name, isEnabled in pairs(data.Toggles) do
            if isEnabled and GUI_Toggles[name] then GUI_Toggles[name].Set(true) end
        end
    end
    if data.Upgrades then
        for id, isSelected in pairs(data.Upgrades) do
            if SELECTED_UPGRADES[id] ~= nil then SELECTED_UPGRADES[id] = isSelected end
        end
    end
end

loadConfig()
print("[Item Farmer] loaded")
