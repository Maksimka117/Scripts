local function makeCard(parent, height)
    local card = Instance.new("Frame")
    card.LayoutOrder = #parent:GetChildren() + 1
    card.Size = UDim2.new(1, -3, 0, height)
    card.BackgroundColor3 = C.panel
    card.BorderSizePixel = 0
    card.Parent = parent
    Instance.new("UICorner", card).CornerRadius = UDim.new(0, 10)
    local cs = Instance.new("UIStroke"); cs.Color = C.stroke; cs.Thickness = 1; cs.Parent = card
    return card
end

local function makeSwitch(parent, label, onToggle)
    local row = makeCard(parent, 50)
    local lbl = Instance.new("TextLabel")
    lbl.Size = UDim2.new(1, -110, 1, 0)
    lbl.Position = UDim2.fromOffset(16, 0)
    lbl.BackgroundTransparency = 1
    lbl.Text = label
    lbl.TextColor3 = C.text
    lbl.TextSize = 13
    lbl.Font = Enum.Font.GothamBold
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.Parent = row

    local sw = Instance.new("TextButton")
    sw.Size = UDim2.fromOffset(60, 28)
    sw.Position = UDim2.new(1, -76, 0.5, -14)
    sw.BackgroundColor3 = C.elem
    sw.Text = ""
    sw.AutoButtonColor = false
    sw.BorderSizePixel = 0
    sw.Parent = row
    Instance.new("UICorner", sw).CornerRadius = UDim.new(1, 0)
    local swS = Instance.new("UIStroke"); swS.Color = C.stroke; swS.Thickness = 1.5; swS.Parent = sw
    local knob = Instance.new("Frame")
    knob.Size = UDim2.fromOffset(22, 22)
    knob.Position = UDim2.new(0, 3, 0.5, -11)
    knob.BackgroundColor3 = C.dim
    knob.BorderSizePixel = 0
    knob.Parent = sw
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)

    local state = false
    local function set(on)
        state = on
        Tween:Create(sw, TweenInfo.new(0.16), {BackgroundColor3 = on and C.accent2 or C.elem}):Play()
        Tween:Create(swS, TweenInfo.new(0.16), {Color = on and C.accent or C.stroke}):Play()
        Tween:Create(knob, TweenInfo.new(0.16), {
            Position = on and UDim2.new(1, -25, 0.5, -11) or UDim2.new(0, 3, 0.5, -11),
            BackgroundColor3 = on and Color3.new(1, 1, 1) or C.dim,
        }):Play()
        if onToggle then onToggle(on) end
    end
    sw.MouseButton1Click:Connect(function()
        if STATE.running then set(not state) end
    end)
    return {Set = set, Get = function() return state end}
end

