-- ==========================================
-- МЕХАНИКА ФАРМА
-- ==========================================
local function farmStep()
    local char = LP.Character
    if not char then return end
    local hrp = char:FindFirstChild("HumanoidRootPart")
    if not hrp then return end

    -- Собираем список всех доступных целей
    local targets = {}
    
    local dropEvent = WS:FindFirstChild("DropEvent")
    if dropEvent then
        for _, obj in ipairs(dropEvent:GetChildren()) do
            if obj:IsA("Model") and string.find(string.lower(obj.Name), "drop") then
                table.insert(targets, obj)
            end
        end
    end

    local pumpkinRain = WS:FindFirstChild("PumpkinRain")
    if pumpkinRain then
        for _, obj in ipairs(pumpkinRain:GetChildren()) do
            if obj:IsA("Model") and string.find(string.lower(obj.Name), "pumpkin") then
                table.insert(targets, obj)
            end
        end
    end

    -- Если нашли цели, начинаем телепортацию
    if #targets > 0 then
        for _, target in ipairs(targets) do
            if not STATE.farm then break end -- Если выключили, прерываемся
            
            -- 1. Фиксируем игрока (чтобы не дергался)
            local oldAnchored = hrp.Anchored
            hrp.Anchored = true
            
            -- 2. Телепортируем к предмету (чуть выше, чтобы подобрать)
            local targetPos = target:GetPivot().Position
            hrp.CFrame = CFrame.new(targetPos + Vector3.new(0, 3, 0))
            
            -- 3. Ждем полсекунды, чтобы игра засчитала подбор
            task.wait(0.5)
            
            -- 4. Возвращаем как было (если не был зафиксирован, снимаем анкор)
            if not oldAnchored then
                hrp.Anchored = false
            end
        end
    end
end

local function setFarm(on)
    STATE.farm = on
    if STATE.farmThr then pcall(task.cancel, STATE.farmThr); STATE.farmThr = nil end
    
    if on then
        STATE.farmThr = task.spawn(function()
            while STATE.running and STATE.farm do
                farmStep()
                task.wait(0.5) -- Пауза между поисками новых пачек
            end
        end)
    end
end

