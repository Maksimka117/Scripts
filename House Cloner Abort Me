local function getOrigin()
    local bp = WS:FindFirstChild("HouseInteriors")
    bp = bp and bp:FindFirstChild("blueprint")
    local interior = bp and bp:GetChildren()[1]
    local sp = interior and interior:FindFirstChild("SpecialParts")
    return sp and sp:FindFirstChild("FurnitureOrigin")
end

local function matchTexture(kind, assetid, partColor)
    local num = tostring(assetid):match("(%d+)")
    if not num then return nil end
    local list = texIndex[kind .. "|" .. num]
    if not list then return nil end
    if #list == 1 then return list[1].key end
    if partColor and partColor ~= Color3.new(1,1,1) then
        local best, bestDist
        for _, t in ipairs(list) do
            if t.color3 then
                local c3 = Color3.new(t.color3[1] or 1, t.color3[2] or 1, t.color3[3] or 1)
                local d = (c3.R-partColor.R)^2 + (c3.G-partColor.G)^2 + (c3.B-partColor.B)^2
                if not bestDist or d < bestDist then best, bestDist = t.key, d end
            end
        end
        if best then return best end
    end
    return list[1].key
end

local function safeInvoke(remote, args, timeout)
    timeout = timeout or 20
    local done, result = false, nil
    task.spawn(function()
        local ok, res = pcall(function() return remote:InvokeServer(unpack(args)) end)
        result = { ok = ok, res = res }
        done = true
    end)
    local t = tick()
    while not done and tick() - t < timeout do task.wait(0.05) end
    if not done then return false, "TIMEOUT" end
    return result.ok, result.res
end

local function getAllSlotsInHouse()
    local slots = {}
    local fRoot = WS.HouseInteriors and WS.HouseInteriors:FindFirstChild("furniture")
    if not fRoot then return slots end
    for _, folder in ipairs(fRoot:GetChildren()) do
        local slot = folder.Name:match("f%-(%d+)")
        if slot then table.insert(slots, "f-" .. slot) end
    end
    return slots
end

local function collectColors(innerModel)
    local colors, seen = {}, {}
    local colorable = innerModel:FindFirstChild("Colorable", true)
    if colorable and (colorable:IsA("BasePart") or colorable:IsA("MeshPart")) then
        table.insert(colors, colorable.Color)
        seen[string.format("%.3f_%.3f_%.3f", colorable.Color.R, colorable.Color.G, colorable.Color.B)] = true
    end
    for _, part in ipairs(innerModel:GetDescendants()) do
        if (part:IsA("BasePart") or part:IsA("MeshPart"))
           and not TECH_PARTS[part.Name] and part.Name ~= "Colorable" then
            local c = part.Color
            if not (c.R == 1 and c.G == 0 and c.B == 0) then
                local key = string.format("%.3f_%.3f_%.3f", c.R, c.G, c.B)
                if not seen[key] then
                    seen[key] = true
                    table.insert(colors, c)
                end
            end
        end
    end
    if #colors == 0 then table.insert(colors, Color3.new(1, 1, 1)) end
    return colors
end

-- ============================================
-- СЕРИАЛИЗАЦИЯ
-- ============================================
local function serializeSnapshot(snap)
    local data = {
        items = {}, textures = snap.textures or { walls = {}, floors = {} },
        totalCost = snap.totalCost or 0, texCount = snap.texCount or 0,
        timestamp = snap.timestamp or os.time(), name = snap.name or "unnamed",
    }
    for _, it in ipairs(snap.items or {}) do
        local s = {
            kind = it.kind, name = it.name, model_name = it.model_name,
            slot = it.slot, cframe_components = it.cframe_components,
            col_size = it.col_size, colors = {},
        }
        for _, c in ipairs(it.colors or {}) do
            if typeof(c) == "Color3" then table.insert(s.colors, {c.R, c.G, c.B})
            elseif type(c) == "table" and #c >= 3 then table.insert(s.colors, c) end
        end
        table.insert(data.items, s)
    end
    return data
end

local function deserializeSnapshot(data)
    local snap = {
        items = {}, textures = data.textures or { walls = {}, floors = {} },
        totalCost = data.totalCost or 0, texCount = data.texCount or 0,
        timestamp = data.timestamp or os.time(), name = data.name or "unnamed",
    }
    for _, it in ipairs(data.items or {}) do
        local colors = {}
        for _, c in ipairs(it.colors or {}) do
            if type(c) == "table" and #c >= 3 then
                table.insert(colors, Color3.new(c[1], c[2], c[3]))
            end
        end
        table.insert(snap.items, {
            kind = it.kind, name = it.name, model_name = it.model_name,
            slot = it.slot, cframe_components = it.cframe_components,
            col_size = it.col_size, colors = colors,
        })
    end
    return snap
end

-- ============================================
-- СОХРАНЕНИЯ
-- ============================================
local function saveSnapshotToFile(name)
    local snap = _G.houseSnapshot
    if not snap then return false, "Нет снапшота" end
    if not writefile then return false, "writefile недоступен" end

    name = tostring(name or ""):gsub("[^%w_%-]", "")
    if name == "" then return false, "Пустое имя" end

    ensureFileFolder()

    local data = serializeSnapshot(snap)
    data.name = name
    local json = HS:JSONEncode(data)

    local path = getFilePath(name)
    local ok, err = pcall(function() writefile(path, json) end)
    if not ok then return false, "Ошибка: " .. tostring(err) end
    return true, path
end

local function loadSnapshotFromFile(name)
    if not readfile then return false, "readfile недоступен" end

    name = tostring(name or ""):gsub("[^%w_%-]", "")
    if name == "" then return false, "Пустое имя" end

    local path = getFilePath(name)
    local ok, content = pcall(function() return readfile(path) end)
    if not ok or not content then return false, "Файл не найден: " .. path end

    local ok2, data = pcall(function() return HS:JSONDecode(content) end)
    if not ok2 or type(data) ~= "table" then return false, "Повреждённый JSON" end

    _G.houseSnapshot = deserializeSnapshot(data)
    return true, _G.houseSnapshot
end

local function deleteSave(name)
    name = tostring(name or ""):gsub("[^%w_%-]", "")
    if name == "" then return false end
    if delfile then
        pcall(function() delfile(getFilePath(name)) end)
    end
    return true
end

local function listSaves()
    local list = {}

    -- Из папки инжектора
    if listfiles then
        local ok, files = pcall(function() return listfiles(FILE_FOLDER) end)
        if ok and files then
            for _, f in ipairs(files) do
                local base = f:match("([^/\\]+)%.json$")
                if base then table.insert(list, base) end
            end
        end
    end

    table.sort(list)
    return list
end

-- ============================================
-- SCAN
-- ============================================
local function doScan(report)
    local origin = getOrigin()
    if not origin then report("❌ Не найден FurnitureOrigin.", true) return false end
    report("Сканирую мебель...", false)

    local items = {}
    local fRoot = WS.HouseInteriors:FindFirstChild("furniture")

    if fRoot then
        for _, folder in ipairs(fRoot:GetChildren()) do
            local slot = folder.Name:match("f%-(%d+)")
            if slot then
                local innerModel
                for _, ch in ipairs(folder:GetChildren()) do
                    if ch:IsA("Model") then innerModel = ch; break end
                end
                if innerModel then
                    local kind = innerModel:GetAttribute("furniture_kind")
                    if not kind then
                        local entry = byModelName[innerModel.Name] or byModelName[innerModel.Name:lower()]
                        kind = entry and entry.id
                    end
                    local anchor = innerModel:FindFirstChild("PlacementBlock")
                        or folder:FindFirstChildWhichIsA("BasePart", true)
                    if anchor and kind then
                        local relCF = origin.CFrame:Inverse() * anchor.CFrame
                        local colors = collectColors(innerModel)
                        local col = innerModel:FindFirstChild("Colorable", true)
                        local colSize = col and {col.Size.X, col.Size.Y, col.Size.Z} or nil
                        table.insert(items, {
                            kind = kind, name = innerModel.Name, model_name = innerModel.Name,
                            slot = tonumber(slot), rel_cframe = relCF,
                            cframe_components = { relCF:GetComponents() },
                            colors = colors, col_size = colSize,
                        })
                    end
                end
            end
        end
    end

    report(string.format("Мебель: %d. Обои...", #items), false)

    local textures = { walls = {}, floors = {} }
    do
        local bp = WS.HouseInteriors:FindFirstChild("blueprint")
        local interior = bp and bp:GetChildren()[1]
        if interior then
            for _, roomGroup in ipairs({"Floors", "Walls"}) do
                local kind = roomGroup:lower()
                local g = interior:FindFirstChild(roomGroup)
                if g then
                    local roomVotes = {}
                    for _, part in ipairs(g:GetChildren()) do
                        if part:IsA("BasePart") then
                            for _, ch in ipairs(part:GetChildren()) do
                                if ch:IsA("Texture") then
                                    local key = matchTexture(kind, ch.Texture, part.Color)
                                    if key then
                                        roomVotes[ch.Name] = roomVotes[ch.Name] or {}
                                        roomVotes[ch.Name][key] = (roomVotes[ch.Name][key] or 0) + 1
                                    end
                                end
                            end
                        end
                    end
                    for roomName, votes in pairs(roomVotes) do
                        local bestKey, bestCount
                        for k, cnt in pairs(votes) do
                            if not bestCount or cnt > bestCount then bestKey, bestCount = k, cnt end
                        end
                        if bestKey then
                            table.insert(textures[kind], { room_name = roomName, key = bestKey })
                        end
                    end
                end
            end
        end
    end

    local totalFurniture = 0
    for _, it in ipairs(items) do
        local entry = FurnitureDB and FurnitureDB[it.kind]
        totalFurniture = totalFurniture + (entry and entry.cost or 0)
    end
    local texTotal = #textures.walls + #textures.floors

    _G.houseSnapshot = {
        items = items, textures = textures,
        totalCost = totalFurniture, texCount = texTotal,
        timestamp = os.time(), name = "unsaved_" .. os.time(),
    }

    report(string.format("✅ Скан: мебель %d | обои %d | полы %d",
        #items, #textures.walls, #textures.floors), false)
    return true
end

-- ============================================
-- PASTE
-- ============================================
local function doPaste(report, progressFn, clearFirst)
    local snap = _G.houseSnapshot
    if not snap then report("❌ Нет снапшота.", true) return end
    local myOrigin = getOrigin()
    if not myOrigin then report("❌ Ты не в своём доме.", true) return end

    local API = RS:FindFirstChild("API")
    if not API then report("❌ Нет API", true) return end

    local BuyFurnitures  = API:FindFirstChild("HousingAPI/BuyFurnitures")
    local PushChanges    = API:FindFirstChild("HousingAPI/PushFurnitureChanges")
    local BuyTexture     = API:FindFirstChild("HousingAPI/BuyTexture")
    local SellFurniture  = API:FindFirstChild("HousingAPI/SellFurniture")

    if not BuyFurnitures then report("❌ Нет BuyFurnitures", true) return end

    if clearFirst and SellFurniture then
        local slots = getAllSlotsInHouse()
        if #slots > 0 then
            report(string.format("Удаляю %d старых...", #slots), false)
            for i = 1, #slots, 15 do
                local batch = {}
                for j = i, math.min(i + 14, #slots) do table.insert(batch, slots[j]) end
                pcall(function() SellFurniture:FireServer(true, batch, "sell") end)
                task.wait(0.3)
            end
            task.wait(1)
        end
    end

    local items = snap.items or {}
    local total = #items
    local spent, failed, skipped = 0, 0, 0
    local noMoneyStop = false
    local purchasedMap = {}

    for i = 1, total, 5 do
        if noMoneyStop then break end
        local batch, batchMeta, batchCoins = {}, {}, 0
        for j = i, math.min(i + 4, total) do
            local it = items[j]
            local entry = FurnitureDB and FurnitureDB[it.kind]
            local cost = entry and entry.cost or 0
            if it.cframe_components then
                local cf = CFrame.new(unpack(it.cframe_components))
                table.insert(batch, { kind = it.kind, properties = { cframe = cf } })
                table.insert(batchMeta, { idx = j, cost = cost })
                batchCoins = batchCoins + cost
            else skipped = skipped + 1 end
        end

        if #batch > 0 then
            local ok, res = safeInvoke(BuyFurnitures, {batch}, 20)
            if ok and type(res) == "table" and res.success and type(res.results) == "table" then
                spent = spent + batchCoins
                for k, r in ipairs(res.results) do
                    if r.status == "SUCCESS" and r.unique then
                        local meta = batchMeta[k]
                        if meta then purchasedMap[meta.idx] = r.unique end
                    elseif r.status == "NOT_ENOUGH_MONEY" then noMoneyStop = true end
                end
            else
                failed = failed + #batch
            end
        end

        progressFn(math.min(i + 4, total), total,
            string.format("Мебель %d/%d • %d монет", math.min(i + 4, total), total, spent))
        task.wait(0.4)
    end

    local changes = {}
    local appliedCount = 0
    local fRootP = WS.HouseInteriors:FindFirstChild("furniture")

    for idx, newSlot in pairs(purchasedMap) do
        local it = items[idx]
        if it then
            local currentSize = nil
            if fRootP then
                for _, f in ipairs(fRootP:GetChildren()) do
                    if f.Name:find(tostring(newSlot), 1, true) then
                        local innerModel
                        for _, ch in ipairs(f:GetChildren()) do
                            if ch:IsA("Model") then innerModel = ch; break end
                        end
                        if innerModel then
                            local col = innerModel:FindFirstChild("Colorable", true)
                            if col then currentSize = {col.Size.X, col.Size.Y, col.Size.Z} end
                        end
                        break
                    end
                end
            end

            local scale = 1
            if it.col_size and currentSize and currentSize[1] > 0 then
                local ratio = it.col_size[1] / currentSize[1]
                if ratio > 0.01 and ratio < 100 then scale = ratio end
            end

            local colors = {}
            for _, c in ipairs(it.colors or {}) do
                if typeof(c) == "Color3" then table.insert(colors, c) end
            end
            if #colors == 0 then table.insert(colors, Color3.new(1, 1, 1)) end

            table.insert(changes, {
                scale = scale, unique = newSlot, colors = colors,
                cframe = CFrame.new(unpack(it.cframe_components)),
            })
            appliedCount = appliedCount + 1
        end
    end

    report(string.format("Применяю %d предметов...", appliedCount), false)
    if PushChanges then
        for i = 1, #changes, 10 do
            local cbatch = {}
            for j = i, math.min(i + 9, #changes) do table.insert(cbatch, changes[j]) end
            pcall(function() PushChanges:FireServer(cbatch) end)
            progressFn(i, #changes, string.format("Цвета+размер %d/%d", i, #changes))
            task.wait(0.4)
        end
        pcall(function() PushChanges:FireServer({}) end)
    end
    task.wait(0.4)

    local walls = snap.textures.walls or {}
    local floors = snap.textures.floors or {}
    local texTotal = #walls + #floors
    local tc = 0
    for _, t in ipairs(walls) do
        tc = tc + 1
        if BuyTexture then pcall(function() BuyTexture:FireServer(t.room_name, "walls", t.key) end) end
        spent = spent + 1
        progressFn(tc, texTotal, string.format("Обои %d/%d", tc, texTotal))
        task.wait(0.3)
    end
    for _, t in ipairs(floors) do
        tc = tc + 1
        if BuyTexture then pcall(function() BuyTexture:FireServer(t.room_name, "floors", t.key) end) end
        spent = spent + 1
        progressFn(tc, texTotal, string.format("Полы %d/%d", tc, texTotal))
        task.wait(0.3)
    end

    if PushChanges then pcall(function() PushChanges:FireServer({}) end) end

    local finalMsg = string.format("✅ Готово! Мебель: %d/%d | Обои+полы: %d | Потрачено ~%d",
        total - failed - skipped, total, texTotal, spent)
    if noMoneyStop then finalMsg = finalMsg .. " | ⚠ Не хватило денег" end
    report(finalMsg, false)
end

local function doClear(report, progressFn)
    local API = RS:FindFirstChild("API")
    local SellFurniture = API and API:FindFirstChild("HousingAPI/SellFurniture")
    if not SellFurniture then report("❌ Нет SellFurniture", true) return end

    local slots = getAllSlotsInHouse()
    if #slots == 0 then report("Дом пустой.", false) return end

    report(string.format("Удаляю %d...", #slots), false)
    local removed = 0
    for i = 1, #slots, 15 do
        local batch = {}
        for j = i, math.min(i + 14, #slots) do table.insert(batch, slots[j]) end
        if pcall(function() SellFurniture:FireServer(true, batch, "sell") end) then
            removed = removed + #batch
        end
        progressFn(math.min(i + 14, #slots), #slots,
            string.format("Удалено %d/%d", math.min(i + 14, #slots), #slots))
        task.wait(0.3)
    end
    report(string.format("✅ Удалено: %d/%d", removed, #slots), false)
end

