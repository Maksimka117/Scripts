-- ============================================
-- КНОПКА M — перетаскивание + клик
-- ============================================
local draggingM = false
local dragStartInput = nil
local startPosM = nil

openBtn.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        draggingM = true
        dragStartInput = input.Position
        startPosM = openBtn.Position
    end
end)

openBtn.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        if draggingM then
            local delta = input.Position - dragStartInput
            openBtn.Position = UDim2.new(
                startPosM.X.Scale, startPosM.X.Offset + delta.X,
                startPosM.Y.Scale, startPosM.Y.Offset + delta.Y
            )
        end
    end
end)

openBtn.InputEnded:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        if draggingM then
            draggingM = false
            -- Разница между НАЧАЛЬНОЙ и КОНЕЧНОЙ позицией кнопки
            local deltaX = math.abs(openBtn.Position.X.Offset - startPosM.X.Offset)
            local deltaY = math.abs(openBtn.Position.Y.Offset - startPosM.Y.Offset)
            -- Если сдвинули меньше 5 пикселей — считаем кликом
            if deltaX < 5 and deltaY < 5 then
                main.Visible = true
                openBtn.Visible = false
            end
        end
    end
end)

-- ============================================
-- ПЕРЕТАСКИВАНИЕ ОСНОВНОГО ОКНА
-- ============================================
local dragging, dragInput, dragStart, startPos
header.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseButton1
    or input.UserInputType == Enum.UserInputType.Touch then
        dragging = true
        dragStart = input.Position
        startPos = main.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then
                dragging = false
            end
        end)
    end
end)
header.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.MouseMovement
    or input.UserInputType == Enum.UserInputType.Touch then
        dragInput = input
    end
end)
UserInputService.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        main.Position = UDim2.new(
            startPos.X.Scale, startPos.X.Offset + delta.X,
            startPos.Y.Scale, startPos.Y.Offset + delta.Y
        )
    end
end)

