local TECH_PARTS = {
    ["Front"]=true,["Back"]=true,["Top"]=true,["Left"]=true,["Right"]=true,["Bottom"]=true,
    ["PlacementBlock"]=true,["UseBlock"]=true,["Collider"]=true,["Hint"]=true,
    ["PlayerCounter"]=true,["BudgetCounter"]=true,["Handle"]=true,["Ring"]=true,["Center"]=true,
}

local byModelName = {}
if FurnitureDB then
    for id, e in pairs(FurnitureDB) do
        if e.model_name then
            byModelName[e.model_name] = e
            byModelName[e.model_name:lower()] = e
        end
    end
end

local texIndex = {}
local function addTex(kind, key, entry)
    local tid = entry.texture_id or ""
    local num = tostring(tid):match("(%d+)")
    if not num then return end
    local k = kind .. "|" .. num
    texIndex[k] = texIndex[k] or {}
    table.insert(texIndex[k], { key = key, color3 = entry.color3, name = entry.name })
end
if TexturesDB then
    for k, e in pairs(TexturesDB.walls  or {}) do if type(e)=="table" then addTex("walls",  k, e) end end
    for k, e in pairs(TexturesDB.floors or {}) do if type(e)=="table" then addTex("floors", k, e) end end
end

