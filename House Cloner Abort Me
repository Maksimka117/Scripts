local logLines = {}
local MAX_LOG = 80

local function addLog(msg, isError)
    local row = Instance.new("Frame")
    row.Size = UDim2.new(1, -8, 0, 16)
    row.BackgroundTransparency = 1
    row.Parent = logScroll

    local t = Instance.new("TextLabel")
    t.Size = UDim2.new(0, 60, 1, 0)
    t.BackgroundTransparency = 1
    t.Text = os.date("%H:%M:%S")
    t.TextColor3 = Color3.fromRGB(80, 80, 88)
    t.TextSize = 10
    t.Font = Enum.Font.Code
    t.TextXAlignment = Enum.TextXAlignment.Left
    t.Parent = row

    local m = Instance.new("TextLabel")
    m.Size = UDim2.new(1, -60, 1, 0)
    m.Position = UDim2.new(0, 60, 0, 0)
    m.BackgroundTransparency = 1
    m.Text = msg
    m.TextColor3 = isError and Color3.fromRGB(255, 120, 120) or C.text
    m.TextSize = 10
    m.Font = Enum.Font.Code
    m.TextXAlignment = Enum.TextXAlignment.Left
    m.Parent = row

    table.insert(logLines, row)
    if #logLines > MAX_LOG then
        local oldRow = table.remove(logLines, 1)
        if oldRow then oldRow:Destroy() end
    end
    task.defer(function()
        logScroll.CanvasPosition = Vector2.new(0, math.max(0, logLayout.AbsoluteContentSize.Y))
    end)
end

local function setStatus(msg, isError)
    statusTxt.Text = msg
    statusDot.BackgroundColor3 = isError and C.red or C.green
    addLog(msg, isError)
end

local function setProgress(c, m, label)
    if m <= 0 then
        progFill.Size = UDim2.new(0, 0, 1, 0)
        progTxt.Text = "—"
        return
    end
    progFill:TweenSize(UDim2.new(math.clamp(c/m, 0, 1), 0, 1, 0), "Out", "Quad", 0.15, true)
    if label then progTxt.Text = label end
end

local function refreshInfo()
    local snap = _G.houseSnapshot
    if not snap then
        infoTxt.Text = "📭  Нет снапшота\n\nЗайди в чужой дом и нажми «Сканировать»"
        return
    end
    local totalTex = (snap.texCount or 0)
    local furnCost = snap.totalCost or 0
    local texCost = totalTex * 2
    local totalPrice = furnCost + texCost

    infoTxt.Text = string.format(
        "📦  Снапшот: %s\n" ..
        "🪑  Мебель: %d шт   |   🎨  Обои: %d + Полы: %d\n" ..
        "💰  Нужно: %d монет\n" ..
        "🕒  Снят: %s",
        snap.name or "?",
        #(snap.items or {}),
        #((snap.textures or {}).walls or {}),
        #((snap.textures or {}).floors or {}),
        totalPrice,
        os.date("%H:%M:%S", snap.timestamp or 0)
    )
end

local function refreshSaveList()
    for _, ch in ipairs(listFrame:GetChildren()) do
        if ch:IsA("TextButton") or ch:IsA("TextLabel") then ch:Destroy() end
    end

    local saves = listSaves()
    if #saves == 0 then
        local e = Instance.new("TextLabel")
        e.Size = UDim2.new(1, -8, 0, 20)
        e.BackgroundTransparency = 1
        e.Text = "(пусто)"
        e.TextColor3 = C.textDim
        e.TextSize = 11
        e.Font = Enum.Font.Gotham
        e.Parent = listFrame
        return
    end

    for i, name in ipairs(saves) do
        local row = Instance.new("TextButton")
        row.Size = UDim2.new(1, -6, 0, 30)
        row.BackgroundColor3 = C.bgElem
        row.BorderSizePixel = 0
        row.Text = "   " .. name
        row.TextColor3 = C.text
        row.TextSize = 11
        row.Font = Enum.Font.Gotham
        row.TextXAlignment = Enum.TextXAlignment.Left
        row.AutoButtonColor = false
        row.Parent = listFrame
        Instance.new("UICorner", row).CornerRadius = UDim.new(0, 6)

        row.MouseButton1Click:Connect(function()
            nameBox.Text = name
            setStatus("Выбрано: " .. name, false)
        end)
        row.MouseEnter:Connect(function() row.BackgroundColor3 = C.bgHover end)
        row.MouseLeave:Connect(function() row.BackgroundColor3 = C.bgElem end)
    end
end

