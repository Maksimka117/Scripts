local function selectTab(idx)
    currentTab = idx
    for i, t in ipairs(tabs) do
        if i == idx then
            t.btn.BackgroundColor3 = C.bgPanel
            t.lb.TextColor3 = C.text
            TweenService:Create(t.ind, TweenInfo.new(0.2), {Size = UDim2.new(0, 3, 0, 22)}):Play()
        else
            t.btn.BackgroundColor3 = C.bg
            t.lb.TextColor3 = C.textDim
            TweenService:Create(t.ind, TweenInfo.new(0.2), {Size = UDim2.new(0, 3, 0, 0)}):Play()
        end
    end
    for i, p in ipairs(panels) do p.Visible = (i == idx) end
end

