    scanning = true
    saveBtn.Text = "   ⏳  Сканирую..."
    setProgress(0, 1, "Сканирую для сохранения...")
    setStatus("Сканирую дом для сохранения...", false)

    task.spawn(function()
        -- Сканируем чужой дом
        local ok = doScan(function(msg, isErr) setStatus(msg, isErr) end)
        if ok then
            -- Сохраняем в файл
            local ok2, result = saveSnapshotToFile(name)
            if ok2 then
                _G.houseSnapshot.name = name
                setStatus("✅ Сохранено: " .. name, false)
                refreshInfo()
                refreshSaveList()
            else
                setStatus("❌ " .. tostring(result), true)
            end
        end
        scanning = false
        saveBtn.Text = "   💾  Сохранить дом"
    end)
end)

loadBtn.MouseButton1Click:Connect(function()
    if scanning or pasting or clearing then return end
    local name = nameBox.Text
    if name == "" then setStatus("❌ Введи имя.", true) return end

    -- Читаем файл
    local ok, result = loadSnapshotFromFile(name)
    if not ok then
        setStatus("❌ " .. tostring(result), true)
        return
    end

    setStatus("✅ Загружено: " .. name, false)
    refreshInfo()

    -- Сразу вставляем
    pasting = true
    loadBtn.Text = "   ⏳  Вставляю..."
    setProgress(0, 1, "Вставляю из файла...")
    setStatus("Вставляю дом из файла...", false)

    task.spawn(function()
        doPaste(
            function(msg, isErr) setStatus(msg, isErr) end,
            function(c, m, label) setProgress(c, m, label) end,
            true
        )
        pasting = false
        loadBtn.Text = "   📂  Загрузить дом"
    end)
end)
deleteBtn.MouseButton1Click:Connect(function()
    local name = nameBox.Text
    if name == "" then setStatus("❌ Введи имя.", true) return end
    deleteSave(name)
    setStatus("🗑 Удалено: " .. name, false)
    refreshSaveList()
end)

