local function equipTool(tool)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    if tool.Parent == char then return true end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool.Parent = Backpack
    end

    tool.Parent = char
    humanoid:EquipTool(tool)
    return true
end

local sellThread = nil

local function startAutoSell()
    if sellThread then return end
    sellThread = task.spawn(function()
        while AutoSellEnabled do
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if not char or not bp then
                task.wait(0.5)
                continue
            end

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then
                task.wait(0.5)
                continue
            end

            local found = false

            for _, itemName in ipairs(ItemsToSell) do
                if not AutoSellEnabled then break end

                for _, tool in ipairs(bp:GetChildren()) do
                    if tool:IsA("Tool") and tool.Name == itemName then
                        found = true
                        if equipTool(tool) then
                            task.wait(0.08)
                            if SellEvent then
                                pcall(function()
                                    SellEvent:FireServer()
                                end)
                                setStatus("Продано: " .. itemName, Color3.fromRGB(90, 220, 90))
                            else
                                setStatus("Ивент продажи не найден!", Color3.fromRGB(255, 80, 80))
                            end
                            task.wait(SellDelay)
                        end
                        break
                    end
                end

                if not found then
                    local equipped = char:FindFirstChildOfClass("Tool")
                    if equipped and equipped.Name == itemName then
                        found = true
                        if SellEvent then
                            pcall(function()
                                SellEvent:FireServer()
                            end)
                            setStatus("Продано: " .. itemName, Color3.fromRGB(90, 220, 90))
                        end
                        task.wait(SellDelay)
                    end
                end
            end

            if not found then
                local equipped = char:FindFirstChildOfClass("Tool")
                if equipped and not table.find(ItemsToSell, equipped.Name) then
                    equipped.Parent = bp
                end
                setStatus("Ожидание предметов...", Color3.fromRGB(150, 150, 150))
                task.wait(0.4)
            end
        end
        sellThread = nil
    end)
end

local function stopAutoSell()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char and bp then
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then
            equipped.Parent = bp
        end
    end
    setStatus("Авто-продажа выключена", Color3.fromRGB(180, 180, 180))
end

AddBtn.MouseButton1Click:Connect(function()
    local name = InputBox.Text:gsub("^%s+", ""):gsub("%s+$", "")
    if name == "" then
        setStatus("Введите название!", Color3.fromRGB(255, 80, 80))
        return
    end
    if table.find(ItemsToSell, name) then
        setStatus("Уже в списке", Color3.fromRGB(255, 180, 60))
        return
    end
    table.insert(ItemsToSell, name)
    InputBox.Text = ""
    refreshList()
    setStatus("Добавлено: " .. name, Color3.fromRGB(90, 220, 90))
end)

InputBox.FocusLost:Connect(function(enterPressed)
    if enterPressed then
        AddBtn:FireButtonClick()
    end
end)

local function onToggleClick()
    AutoSellEnabled = not AutoSellEnabled
    updateToggleVisual()

    if AutoSellEnabled then
        if #ItemsToSell == 0 then
            setStatus("Список пуст! Добавьте предметы.", Color3.fromRGB(255, 80, 80))
            AutoSellEnabled = false
            updateToggleVisual()
            return
        end
        setStatus("Запуск авто-продажи...", Color3.fromRGB(255, 180, 60))
        startAutoSell()
    else
        stopAutoSell()
    end
end

