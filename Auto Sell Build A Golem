local function equipTool(tool)
    local char = LocalPlayer.Character
    if not char then return false end
    local humanoid = char:FindFirstChildOfClass("Humanoid")
    if not humanoid then return false end

    if tool.Parent == char then return true end

    local currentTool = char:FindFirstChildOfClass("Tool")
    if currentTool then
        currentTool.Parent = Backpack
    end

    tool.Parent = char
    humanoid:EquipTool(tool)
    return true
end

local function matchesFilter(tool, entry)
    if entry.mode == "Exact" then
        if tool.Name == entry.value then return true end

        if tool.Name == "Golem" then
            local mat = detectMaterial(tool)
            if mat then
                local fullName = mat .. " Golem"
                if string.lower(fullName) == string.lower(entry.value) then
                    return true
                end
            end
        end
        return false
    else
        local mat = detectMaterial(tool)
        if mat then
            return string.lower(mat) == string.lower(entry.value)
        end
        return string.find(string.lower(tool.Name), string.lower(entry.value), 1, true) ~= nil
    end
end

local sellThread = nil

local function startAutoSell()
    if sellThread then return end
    sellThread = task.spawn(function()
        while AutoSellEnabled do
            local char = LocalPlayer.Character
            local bp = LocalPlayer:FindFirstChild("Backpack")
            if not char or not bp then
                task.wait(0.5)
                continue
            end

            local humanoid = char:FindFirstChildOfClass("Humanoid")
            if not humanoid then
                task.wait(0.5)
                continue
            end

            local soldThisCycle = false

            local tools = {}
            for _, t in ipairs(bp:GetChildren()) do
                if t:IsA("Tool") then table.insert(tools, t) end
            end

            for _, tool in ipairs(tools) do
                if not AutoSellEnabled then break end

                local shouldSell = false

                for _, entry in ipairs(ItemsToSell) do
                    if matchesFilter(tool, entry) then
                        shouldSell = true
                        break
                    end
                end

                if shouldSell then
                    if equipTool(tool) then
                        task.wait(0.1)
                        if SellEvent then
                            pcall(function() SellEvent:FireServer() end)
                            local displayName = getGolemFullName(tool) or tool.Name
                            setStatus("Продано: " .. displayName, Color3.fromRGB(90, 220, 90))
                            soldThisCycle = true
                        else
                            setStatus("Ивент продажи не найден!", Color3.fromRGB(255, 80, 80))
                        end
                        task.wait(SellDelay)
                    end
                end
            end

            if not soldThisCycle then
                local equipped = char:FindFirstChildOfClass("Tool")
                if equipped then
                    equipped.Parent = bp
                end
                setStatus("Ожидание подходящих предметов...", Color3.fromRGB(150, 150, 150))
                task.wait(0.4)
            end
        end
        sellThread = nil
    end)
end

local function stopAutoSell()
    local char = LocalPlayer.Character
    local bp = LocalPlayer:FindFirstChild("Backpack")
    if char and bp then
        local equipped = char:FindFirstChildOfClass("Tool")
        if equipped then
            equipped.Parent = bp
        end
    end
    setStatus("Авто-продажа остановлена", Color3.fromRGB(180, 180, 180))
end

