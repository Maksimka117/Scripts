    table.insert(ItemsToSell, { value = value, mode = Mode })
    InputBox.Text = ""
    refreshList()
    setStatus("Добавлено [" .. (Mode == "Exact" and "имя" or "мат") .. "]: " .. value,
        Color3.fromRGB(90, 220, 90))
end)

