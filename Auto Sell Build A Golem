local function buildMaterialsDatabase()
    local assets = ReplicatedStorage:FindFirstChild("assets")
    if not assets then
        warn("[AutoSell] assets не найден!")
        return
    end
    local parts = assets:FindFirstChild("golem-parts")
    if not parts then
        warn("[AutoSell] assets.golem-parts не найден!")
        return
    end

    for _, folder in ipairs(parts:GetChildren()) do
        if folder:IsA("Folder") then
            local materialName = folder.Name:gsub("%-golem$", ""):gsub("^%l", string.upper)
            local colorSet = {}
            for _, child in ipairs(folder:GetDescendants()) do
                if child:IsA("BasePart") and child.Material == Enum.Material.Neon then
                    local key = string.format("%d,%d,%d",
                        math.floor(child.Color.R * 255 + 0.5),
                        math.floor(child.Color.G * 255 + 0.5),
                        math.floor(child.Color.B * 255 + 0.5))
                    colorSet[key] = true
                end
            end
            local colorList = {}
            for k in pairs(colorSet) do table.insert(colorList, k) end
            table.sort(colorList)
            Materials[materialName] = {
                colors = colorList,
                folder = folder.Name,
            }
        end
    end
end

buildMaterialsDatabase()

local function getToolColors(tool)
    local colorSet = {}
    for _, d in ipairs(tool:GetDescendants()) do
        if d:IsA("BasePart") and d.Material == Enum.Material.Neon then
            local key = string.format("%d,%d,%d",
                math.floor(d.Color.R * 255 + 0.5),
                math.floor(d.Color.G * 255 + 0.5),
                math.floor(d.Color.B * 255 + 0.5))
            colorSet[key] = true
        end
    end
    return colorSet
end

local function detectMaterial(tool)
    local toolColors = getToolColors(tool)
    if next(toolColors) == nil then return nil end

    local bestMatch, bestScore = nil, 0
    for matName, data in pairs(Materials) do
        local score = 0
        for _, col in ipairs(data.colors) do
            if toolColors[col] then score = score + 1 end
        end
        local ratio = score / #data.colors
        if ratio > bestScore and ratio >= 0.5 then
            bestScore = ratio
            bestMatch = matName
        end
    end
    return bestMatch
end

local function getGolemFullName(tool)
    if tool.Name ~= "Golem" then return nil end
    local mat = detectMaterial(tool)
    if mat then
        return mat .. " Golem"
    end
    return nil
end

